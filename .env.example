# --- Servidor ---
PORT=3000
NODE_ENV=development
# Rótulo lógico (production | staging | development) — usado em logs e validação de storage remoto
APP_ENV=development

# --- Autenticação interna ---
SEFAZ_BRIDGE_SECRET=change-me

# Opcional: exige headers X-Bridge-Timestamp + X-Bridge-Signature (HMAC-SHA256) em rotas protegidas
# BRIDGE_HMAC_SECRET=
# BRIDGE_HMAC_MAX_SKEW_SEC=300

# --- Criptografia at-rest (PFX + senha antes do upload ao Spaces / disco dev) ---
# 32 bytes em hex (64 chars) ou base64
CERT_ENCRYPTION_KEY=

# --- Storage ---
# local = disco cifrado (somente desenvolvimento). production/staging exige spaces na App Platform.
STORAGE_DRIVER=local
CERT_STORAGE_PATH=./storage/certificates

# DigitalOcean Spaces (S3 compatível) — obrigatório quando APP_ENV ou NODE_ENV é production/staging
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BUCKET=
# SPACES_REGION=nyc3
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_PREFIX=sefaz-bridge/local-dev/

# --- SEFAZ ---
# SEFAZ_DISTRIBUICAO_URL=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
SEFAZ_HTTP_TIMEOUT_MS=90000
SEFAZ_HTTP_MAX_RETRIES=2

# --- Logs / debug SOAP ---
LOG_LEVEL=info
# ALLOW_DEBUG_SOAP=true
# DEBUG_SOAP_IN_PROD=false

# --- Rate limit ---
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_CERT_MAX=30
RATE_LIMIT_CERT_WINDOW=15 minutes

# --- CORS (vazio = sem CORS; preenchido = lista separada por vírgula) ---
# CORS_ORIGINS=

# --- Certificado (upload) ---
# Apenas desenvolvimento: permite certificado expirado sem override administrativo
# CERT_ALLOW_EXPIRED_DEV=true
# Segredo para header X-Cert-Override-Token (upload com cert expirado)
# ADMIN_CERT_OVERRIDE_SECRET=
